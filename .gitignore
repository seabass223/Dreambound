# Dependencies and build output
node_modules/
dist/
dist-ssr/
dist-deploy/
.vite/
*.local

# Blender working files. The .blend scenes are regenerated by tools/blender/build_*.py,
# and the shipped assets are the GLBs and textures in public/models.
*.blend
*.blend1
*.blend2
__pycache__/
*.pyc

# Image-editor working files (the shipped images are exported from them, e.g. public/og.webp from src/ui/og-src.psd)
*.psd

# Regression harness scratch output (the baseline*.json files are tracked)
tools/regress/out/

# Offline sound renders (tools/audio): WAVs, spectrograms, and the engine copies --ref pulls from git
tools/audio/out/

# Logs and env
*.log
npm-debug.log*
.env
.env.*
!.env.example

# Bug reports pulled from the queue (tools/bugqueue): screenshots and reports stay local
bugs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Claude Code per-user settings (launch.json is shared)
.claude/settings.local.json
tools/blender/tor_src.json
