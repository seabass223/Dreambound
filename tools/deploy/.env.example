# Copy to tools/deploy/.env (git-ignored) and fill in. Read by tools/deploy/deploy.mjs (npm run deploy).
# This SAS can write to the container, so it stays on this machine: never commit it or put it in the game.

# Container SAS URL with Create + Write + List (sp=cwl); add Delete (sp=cwdl) to use --prune.
# The $web container is the storage account's static website, which serves the game at the site's root.
DEPLOY_SAS=https://<account>.blob.core.windows.net/$web?sv=...&sp=cwl&se=...&sig=...

# Optional folder inside the container (no slashes at either end), e.g. dreambound
DEPLOY_PREFIX=
