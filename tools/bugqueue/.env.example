# Copy to tools/bugqueue/.env (git-ignored) and fill in. Read by tools/bugqueue/lib.mjs.
# The consumer's SAS URLs can read, so they stay on this machine: never put them in the game.

# Queue SAS URL with Read + Process (sp=rp): get and delete messages.
BUG_QUEUE_SAS=https://<account>.queue.core.windows.net/<queue>?sv=...&sp=rp&se=...&sig=...

# Container SAS URL with Read (sp=r): download the screenshots.
BUG_BLOB_SAS=https://<account>.blob.core.windows.net/<container>?sv=...&sp=r&se=...&sig=...

# The verifier's reporter ID: reports sent with it are approved automatically; any other ID waits for review.
BUG_AUTO_APPROVE_ID=
